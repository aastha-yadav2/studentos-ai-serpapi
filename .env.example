# Browser-safe public values from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only AI & Search secrets: configure with Supabase CLI; NEVER put in .env/client files.
# supabase secrets set GROQ_API_KEY=your-groq-api-key
# supabase secrets set SERPAPI_API_KEY=your-serpapi-api-key

# Sanity Structured Opportunity Knowledge Layer (Public Read Access Only)
VITE_SANITY_PROJECT_ID=your-sanity-project-id
VITE_SANITY_DATASET=production

